# QAR-4: every text file is checked out with LF line endings, on Windows too, so a test that
# reads a doc, a fixture or a source file reads the same bytes on every system.
* text=auto eol=lf
# The scoreboard data is compressed: never convert line endings in it.
scoreboard/data/*.gz binary
# The bundled fonts and their licences are shipped byte for byte: never convert them.
packages/cli/fonts/** binary
