{
  "name": "ongrid-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Grid (ongrid): floor plans and plan checks for architects",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
